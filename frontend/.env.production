# Prod build'de Worker API tabanı (herkese açık URL — gizli değil).
# Vite bunu `vite build` sırasında otomatik yükler; deploy:web için env değişkeni gerekmez.
# Worker URL'in değişirse burayı güncelle.
VITE_API_BASE=https://jarvis-api.simulator16.workers.dev

# Web Push VAPID PUBLIC anahtarı (base64url, gizli DEĞİL — client bundle'a gömülür).
# Bu, VAPID_PRIVATE_KEY secret'ıyla AYNI çiftten olmalı. Değiştirmek için `npx @pushforge/builder vapid`
# ile yeni çift üret; public'i buraya, private'ı `wrangler secret put VAPID_PRIVATE_KEY`'e koy.
# NOT: Boş bırakma — boş değer ".env.local"i de ezer (Vite'ta .env.production önceliklidir).
VITE_VAPID_PUBLIC_KEY=BJqVXJGj_m7191-8lJx6CZsmPP1RuIaGjwoVxUmyzMqotPeuJtK13oJ0vuW01Sa57IbBqApvsLFeOV0SOUAkBwM
