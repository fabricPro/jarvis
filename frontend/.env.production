# Prod build'de Worker API tabanı (herkese açık URL — gizli değil).
# Vite bunu `vite build` sırasında otomatik yükler; deploy:web için env değişkeni gerekmez.
# Worker URL'in değişirse burayı güncelle.
VITE_API_BASE=https://jarvis-api.simulator16.workers.dev

# Web Push VAPID PUBLIC anahtarı (base64url, gizli DEĞİL). `npx @pushforge/builder vapid`
# ile üretip public değeri buraya yapıştırın. Boşsa "Hatırlatmaları aç" düğmesi gizlenir.
VITE_VAPID_PUBLIC_KEY=
